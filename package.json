{
  "name": "dbgate-pg-dumper",
  "version": "0.1.5",
  "description": "Standalone, client-agnostic PostgreSQL SQL dump generator for Node.js",
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbgate/dbgate-pg-dumper.git"
  },
  "bugs": {
    "url": "https://github.com/dbgate/dbgate-pg-dumper/issues"
  },
  "homepage": "https://github.com/dbgate/dbgate-pg-dumper#readme",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pg": {
      "types": "./dist/pg.d.ts",
      "import": "./dist/pg.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "tsup --clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:schema": "vitest run --config vitest.integration.config.ts tests/integration/round-trip.test.ts -t \"schema\"",
    "test:integration:data": "vitest run --config vitest.integration.config.ts tests/integration/round-trip.test.ts -t \"data dump|physical export\"",
    "test:integration:advanced": "vitest run --config vitest.integration.config.ts tests/integration/introspection.test.ts",
    "test:integration:cross-version": "vitest run --config vitest.integration.config.ts tests/integration/round-trip.test.ts -t \"cross-version\"",
    "test:integration:restore": "vitest run --config vitest.integration.config.ts tests/integration/native-restore.test.ts tests/integration/native-restore-data.test.ts tests/integration/native-restore-resilience.test.ts",
    "test:integration:slow": "vitest run --config vitest.integration.config.ts tests/integration/data-export.test.ts",
    "test:restore-stress:smoke": "node tools/run-restore-performance.mjs stress smoke",
    "test:restore-stress:ci": "node tools/run-restore-performance.mjs stress ci",
    "test:restore-stress:heap": "node tools/run-restore-performance.mjs heap ci",
    "benchmark:restore": "node tools/run-restore-performance.mjs benchmark smoke",
    "benchmark:restore:large": "node tools/run-restore-performance.mjs benchmark large",
    "benchmark:restore:extreme": "node tools/run-restore-performance.mjs benchmark manual-extreme",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "postgresql",
    "postgres",
    "sql",
    "dump",
    "backup",
    "database"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "pg": ">=8.11.0",
    "pg-copy-streams": ">=7.0.0",
    "pg-query-stream": ">=4.5.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "pg-copy-streams": {
      "optional": true
    },
    "pg-query-stream": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.2",
    "@types/pg-copy-streams": "^1.2.5",
    "eslint": "^9.25.1",
    "pg": "^8.16.3",
    "pg-copy-streams": "^7.0.0",
    "pg-query-stream": "^4.10.3",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vitest": "^3.1.2"
  }
}
