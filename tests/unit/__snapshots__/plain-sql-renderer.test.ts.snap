// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`plain archive orchestration > is deterministic, section ordered, and snapshots a complete small schema 1`] = `
"--
-- dbgate-pg-dumper PostgreSQL schema dump
-- Source PostgreSQL: 18
-- Target PostgreSQL: 18
--

SET statement_timeout = 0;
SET lock_timeout = 0;
SET idle_in_transaction_session_timeout = 0;
SET client_encoding = 'UTF8';
SET standard_conforming_strings = on;
SET DateStyle = 'ISO';
SET IntervalStyle = 'postgres';
SET TimeZone = 'UTC';
SET bytea_output = 'hex';
SET extra_float_digits = 3;
SET lc_monetary = 'C';
SET check_function_bodies = false;
SET client_min_messages = warning;
SET row_security = off;
SELECT pg_catalog.set_config('search_path', '', false);

-- Entry id-schema:app:app: schema:app:app
CREATE SCHEMA app;

-- Entry id-enum:app:mood: enum:app:mood
CREATE TYPE app.mood AS ENUM ('happy', 'sad');

--
-- PostgreSQL schema dump complete
"
`;
